<script>
    $(document).ready(function($) {
        $('.owl-carousel').owlCarousel(
            {
                items: 5,
                nav: true,
                margin:5,
                dots: false
            }
        );
        $('.selectpicker').selectpicker({
//        style: 'btn-info',
            size: 8
        });

        var msxhr;

        $('#matching-slidepanel input').on('change', function(){
            var $target = $('#matching-slidepanel');
            var $contentbox = $($target.attr('data-contentbox'));

            if (msxhr != null) msxhr.abort();
            $contentbox.css('opacity',.5);
            msxhr = $.post($target.attr('data-url'), $target.serialize())
                .done(function(data){
                    $contentbox.html(data);
                    $contentbox.css('opacity',1);
                    $.components._components.selectable.init();
                })
        })

        function initSlidepanelButtons(){

            $('#importAction').click(function(){

                var url = $(this).attr('data-href');
                var l = Ladda.create(this);
                l.start();

                $.post(url)
                    .done(function(data){
                        if (data.status){
                            if (data.redirect) window.location.href = data.redirect;
                        }else{
                            window.errorsCheck(data);
                        }

                    })
                    .always(function() { l.stop(); });



            });
        }

        initSlidepanelButtons();
    });
</script>



